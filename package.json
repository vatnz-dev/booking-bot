{
  "name": "vatnz-booking-bot",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "node .",
    "test": "node --test tests/*.test.js",
    "node-clean": "rm -rf node_modules && rm package-lock.json && npm cache clear --force && npm install",
    "release": "semantic-release"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cheerio": "^1.2.0",
    "discord-sync-commands": "^0.5.2",
    "discord.js": "^14.25.1",
    "dotenv": "^16.0.0",
    "easy-json-database": "^1.0.0",
    "install": "^0.13.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "semantic-release": "^25.0.9"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/github"
    ]
  }
}
