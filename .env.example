DISCORD_TOKEN=your_bot_token_here
# The VATNZ server ID. The bot registers commands only here and leaves any other server.
GUILD_ID=your_server_id_here
# Contact details sent in the User-Agent of every request to VATSIM, StatSim and vatnz.net.
BOT_CONTACT_EMAIL=you@example.org
BOT_CONTACT_URL=https://github.com/vatnz-dev/booking-bot
CHANNEL_ID=your_booking_channel_id_here
LOG_CHANNEL_ID=your_staff_log_channel_id_here
# Bot owners can run /maintenance and /statsim. Only changeable here, never by command.
BOT_OWNER_IDS=your_discord_user_id
# Named users below only keep their access while they hold one of these roles.
BOARD_ROLE_ID=your_board_role_id_here
SENIOR_STAFF_ROLE_ID=your_senior_staff_role_id_here
# Starting lists for each permission (comma-separated). /maintenance changes override them.
BOOKING_MODERATOR_ROLE_IDS=your_events_team_role_id,your_board_role_id
EVENT_THREAD_ROLE_IDS=your_events_team_role_id,your_board_role_id
EVENT_PROMPT_ROLE_IDS=your_events_team_role_id
EVENT_POSITION_USER_IDS=events_director_user_id,operations_director_user_id,events_manager_user_id
MENTOR_APPROVER_USER_IDS=training_director_user_id,training_manager_user_id
EVENT_NOTIFICATIONS_ROLE_ID=your_event_notifications_role_id_here
FSS_ROLE_ID=your_fss_role_id_here
# Only members with this role can be tagged as a mentor or approve mentored bookings.
TRAINING_TEAM_ROLE_ID=your_training_team_role_id_here
S1_ROLE_ID=your_s1_role_id_here
S2_ROLE_ID=your_s2_role_id_here
S3_ROLE_ID=your_s3_role_id_here
C1_ROLE_ID=your_c1_role_id_here
C3_ROLE_ID=your_c3_role_id_here
I1_ROLE_ID=your_i1_role_id_here
I3_ROLE_ID=your_i3_role_id_here
BOOKING_REMINDERS_ENABLED=true
BOOKING_REMINDER_MINUTES=30
EVENT_CALENDAR_URL=https://www.vatnz.net/events/calendar/vatnz-lite.ics
VATNZ_POSITIONS_URL=https://www.vatnz.net/airspace/positions/
SOLO_ENDORSEMENTS_URL=https://www.vatnz.net/controllers/endorsements/approved-solo-endorsements/
S1_SOLO_ENDORSEMENTS_URL=https://www.vatnz.net/controllers/endorsements/list-s1-holders-approved-connect-under-622-s1-tower-trainee-policy/
STATSIM_ENABLED=true
STATSIM_TIMEOUT_MS=15000
STATSIM_HEALTH_CHECK_MINUTES=5
STATSIM_ZERO_FALLBACK_YEARS=3
